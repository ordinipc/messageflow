# ==================== SERVER ====================
NODE_ENV=production
PORT=3000
DOMAIN=https://tuo-dominio.it

# ==================== STRIPE ====================
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_LA_TUA_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_LA_TUA_PUBLISHABLE_KEY

# Dashboard Stripe → Developers → Webhooks (endpoint: https://tuo-dominio.it/webhook)
STRIPE_WEBHOOK_SECRET=whsec_IL_TUO_WEBHOOK_SECRET

# Price ID dei prodotti creati in Stripe
STRIPE_PRICE_ID_PRO=price_ID_PRODOTTO_PRO
STRIPE_PRICE_ID_BUSINESS=price_ID_PRODOTTO_BUSINESS

# ==================== EMAIL (invio licenze e digest bandi) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tua-email@gmail.com
SMTP_PASS=password_per_le_app
SMTP_FROM=tua-email@gmail.com

# ==================== AGGREGATORE BANDI (opzionale) ====================
# Indica un contatto reale: è buona educazione verso gli enti pubblici
BANDI_USER_AGENT=BandiScuolaBot/1.0 (+https://tuo-dominio.it; contatto: tua-email@dominio.it)

# Destinatario del digest dei nuovi bandi
BANDI_EMAIL_TO=tua-email@dominio.it

# Webhook alternativo per il digest (Slack, Telegram, n8n…)
# BANDI_WEBHOOK_URL=https://hooks.example.com/xyz

# Token per abilitare POST /api/bandi/aggiorna (lasciare vuoto per disabilitare)
# BANDI_ADMIN_TOKEN=una_stringa_lunga_e_casuale

# Percorsi (default: bandi/data/bandi.json e bandi/.cache)
# BANDI_DB=./bandi/data/bandi.json
# BANDI_CACHE_DIR=./bandi/.cache
# BANDI_MIN_INTERVAL_MS=1500
